# ローカル開発用の環境変数サンプル
# このファイルを `.dev.vars` にコピーし、値を埋めてください（.dev.vars は git 管理外）

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
TO_EMAIL=your-email@example.com
FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile（CAPTCHA） - 後で有効化する場合に設定
# 未設定の場合 Turnstile による検証はスキップされます
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 居酒屋向け LINE公式ガチャ（functions/api/line-webhook.ts）
# LINE Developers Console > プロバイダー > Messaging API チャネル から取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 任意：返信に表示する店名（未設定なら「居酒屋たかし」）
GACHA_SHOP_NAME=居酒屋たかし
