---
const rows = [
  { label: "事業主", value: "たかし" },
  { label: "事業形態", value: "個人事業主" },
  { label: "事業内容", value: "Web サイト制作 / 業務システム開発 / AI 導入支援" },
  { label: "所在地", value: "仙台市（全国対応）" },
  { label: "経歴", value: "土木施工管理技士・運行管理者として現場歴 16 年以上" },
];
---

<section id="about" class="py-16 md:py-24 relative overflow-hidden">
  <!-- Gray blob (reference: yellow blob) -->
  <svg aria-hidden="true" class="absolute -right-20 bottom-0 w-[380px] h-[300px] text-zinc-100 dark:text-zinc-900 -z-10" viewBox="0 0 380 300" fill="currentColor">
    <path d="M190 20c80-30 170 10 180 90s-60 150-150 170S30 260 20 180 110 50 190 20z" />
  </svg>

  <div class="max-w-[1000px] mx-auto px-6 md:px-10">
    <div class="max-w-xl border-2 border-zinc-900 dark:border-zinc-100 p-6 md:p-10">
      <div class="flex items-start justify-between gap-6">
        <h2 class="text-xl md:text-4xl font-bold tracking-[0.14em] md:tracking-[0.22em]">ABOUT</h2>
        <span class="text-[11px] font-semibold text-zinc-600 dark:text-zinc-400 pt-2">事業概要</span>
      </div>

      <dl class="mt-8 space-y-4 text-sm">
        {rows.map((r) => (
          <div class="grid grid-cols-[80px_1fr] gap-4 items-baseline">
            <dt class="font-bold">{r.label}</dt>
            <dd class="text-zinc-700 dark:text-zinc-300 leading-relaxed">{r.value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-8 text-right">
        <a href="#contact" class="inline-block text-[13px] font-bold tracking-[0.15em] pb-1 border-b-2 border-zinc-900 dark:border-zinc-100 hover:opacity-60 transition-opacity">
          詳細
        </a>
      </div>
    </div>
  </div>
</section>
