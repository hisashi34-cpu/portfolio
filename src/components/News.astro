---
const news = [
  { date: "2026.08.01", title: "ポートフォリオサイトをリニューアルしました", display: "SITE RENEWAL", tone: "dark" },
  { date: "2026.06.28", title: "「青波建設株式会社（デモ）」を実績に追加しました", display: "AONAMI DEMO", tone: "mid" },
  { date: "2026.05.16", title: "「株式会社青葉建設（デモ）」を実績に追加しました", display: "AOBA DEMO", tone: "light" },
];

const tones: Record<string, string> = {
  dark: "bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900",
  mid: "bg-zinc-500 text-white",
  light: "bg-zinc-200 text-zinc-900",
};
---

<section id="news" class="py-16 md:py-24">
  <div class="max-w-[1000px] mx-auto px-6 md:px-10">

    <!-- Vertical boxed label + cards -->
    <div class="grid grid-cols-[64px_1fr] md:grid-cols-[72px_1fr] gap-6 md:gap-10 items-start">
      <div class="border-2 border-zinc-900 dark:border-zinc-100 px-3 py-6 flex flex-col items-center gap-4">
        <span class="text-xl md:text-2xl font-bold tracking-[0.3em]" style="writing-mode: vertical-rl;">NEWS</span>
        <span class="text-[10px] text-zinc-500" style="writing-mode: vertical-rl;">お知らせ</span>
      </div>

      <div class="grid sm:grid-cols-3 gap-6">
        {news.map((n) => (
          <div>
            <div class={`aspect-[4/3] ${tones[n.tone]} flex items-center justify-center p-6 overflow-hidden`}>
              <span class="statement text-xl md:text-2xl leading-[1.3] tracking-[0.1em]" style="writing-mode: vertical-rl;">{n.display}</span>
            </div>
            <p class="mt-3 text-sm font-medium leading-relaxed">{n.title}</p>
            <p class="mt-1 text-xs text-zinc-500 tabular-nums">{n.date}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
