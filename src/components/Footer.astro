---
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/60 dark:border-zinc-800/60 py-10">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-5 text-sm text-zinc-500">
    <div>
      © {year} たかし. All rights reserved.
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href="/#about" class="hover:text-zinc-900 dark:hover:text-white transition">About</a>
      <a href="/#services" class="hover:text-zinc-900 dark:hover:text-white transition">Services</a>
      <a href="/#contact" class="hover:text-zinc-900 dark:hover:text-white transition">Contact</a>
      <span class="text-zinc-300 dark:text-zinc-700">|</span>
      <a href="/privacy" class="hover:text-zinc-900 dark:hover:text-white transition">プライバシーポリシー</a>
      <a href="/terms" class="hover:text-zinc-900 dark:hover:text-white transition">利用規約</a>
    </div>
  </div>
</footer>
