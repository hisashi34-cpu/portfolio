---
import { projects } from "../data/projects";
const VISIBLE = 6;
---

<section id="portfolio" class="py-16 md:py-24">
  <div class="max-w-[1000px] mx-auto px-6 md:px-10">

    <!-- Boxed section title -->
    <div class="border-2 border-zinc-900 dark:border-zinc-100">
      <div class="flex items-stretch">
        <h2 class="px-5 md:px-8 py-4 md:py-5 text-xl md:text-4xl font-bold tracking-[0.14em] md:tracking-[0.22em] border-r-2 border-zinc-900 dark:border-zinc-100">WORKS</h2>
        <div class="flex-1 flex items-end justify-end px-5 pb-3 text-[11px] font-semibold text-zinc-600 dark:text-zinc-400">実績</div>
      </div>
    </div>
    <div class="border-2 border-t-0 border-zinc-900 dark:border-zinc-100 px-5 py-2.5 text-xs md:text-[13px] font-medium">
      Web サイトから業務システムまで、これまでの制作実績の一部をご紹介します
    </div>

    <div class="mt-12 md:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
      {projects.map((p, i) => (
        <article class={`relative group ${i >= VISIBLE ? "hidden extra-work" : ""}`}>
          <a
            href={`/projects/${p.slug}`}
            class="block"
            aria-label={`${p.title}の詳細を見る`}
          >
            <div class={`relative aspect-[4/3] bg-gradient-to-br ${p.gradient} overflow-hidden`}>
              {p.video && p.landscape ? (
                <video
                  src={p.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="absolute inset-0 w-full h-full object-cover"
                ></video>
              ) : p.video ? (
                <video
                  src={p.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="h-[88%] w-auto mx-auto mt-[6%] shadow-xl"
                ></video>
              ) : p.image ? (
                <img
                  src={p.image}
                  alt={p.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center text-zinc-500 dark:text-zinc-400 text-xs tracking-[0.2em] uppercase">No Image</span>
              )}
            </div>

            <h3 class="mt-4 text-base md:text-lg font-bold tracking-tight leading-snug group-hover:opacity-60 transition-opacity">
              {p.title}
            </h3>
            <p class="mt-1.5 text-xs text-zinc-500">{p.category}</p>
          </a>

          {p.link && (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10 mt-3 inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.14em] border-b border-zinc-900 dark:border-zinc-100 pb-0.5 hover:opacity-60 transition-opacity"
              aria-label={`${p.title}のデモサイトを別タブで開く`}
            >
              デモサイトを開く
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>

    <p class="mt-8 text-xs text-zinc-500">当サイトも自ら制作していますので実績の一つとしてご覧ください</p>

    {projects.length > VISIBLE && (
      <div class="mt-10 text-right">
        <button
          id="view-all-works"
          class="inline-block text-[13px] font-bold tracking-[0.2em] pb-1.5 border-b-2 border-zinc-900 dark:border-zinc-100 hover:opacity-60 transition-opacity cursor-pointer"
        >
          実績一覧
        </button>
      </div>
    )}
  </div>
</section>

<script>
  const btn = document.getElementById("view-all-works");
  btn?.addEventListener("click", () => {
    document.querySelectorAll(".extra-work").forEach((el) => el.classList.remove("hidden"));
    btn.parentElement?.classList.add("hidden");
  });
</script>
