---
const services = [
  {
    title: "Web サイト制作",
    lines: ["集客につながるサイトを", "一からデザイン"],
    desc: "コーポレートサイト、LP、EC サイトの設計・開発。SEO・表示速度・保守性を重視し、公開後も運用しやすい構成でつくります。",
    price: "¥300,000〜",
    icon: "M4 5h16v11H4zM2 19h20M9 16v3M15 16v3",
  },
  {
    title: "業務システム開発",
    lines: ["紙と手書きの業務を", "スマホで完結する形に"],
    desc: "LINE 勤怠・AI-OCR・経費精算・有給管理など、現場に合わせた業務アプリを開発。既存業務の刷新や DX 推進もご相談ください。",
    price: "¥800,000〜",
    icon: "M7 3h10v18H7zM7 7h10M10 17h4",
  },
  {
    title: "AI 導入・技術支援",
    lines: ["何から始めるかの整理から", "導入後の伴走まで"],
    desc: "AI 活用の相談、技術選定、アーキテクチャ設計、コードレビューなど、CTO 代行的なポジションで継続的にご支援します。",
    price: "月 ¥150,000〜",
    icon: "M12 3v4M12 17v4M3 12h4M17 12h4M12 8a4 4 0 100 8 4 4 0 000-8z",
  },
];
---

<section id="services" class="py-16 md:py-24">
  <div class="max-w-[1000px] mx-auto px-6 md:px-10">

    <!-- Boxed section title -->
    <div class="border-2 border-zinc-900 dark:border-zinc-100">
      <div class="flex items-stretch">
        <h2 class="px-5 md:px-8 py-4 md:py-5 text-xl md:text-4xl font-bold tracking-[0.14em] md:tracking-[0.22em] border-r-2 border-zinc-900 dark:border-zinc-100">SERVICE</h2>
        <div class="flex-1 flex items-end justify-end px-5 pb-3 text-[11px] font-semibold text-zinc-600 dark:text-zinc-400">サービス内容</div>
      </div>
    </div>
    <div class="border-2 border-t-0 border-zinc-900 dark:border-zinc-100 px-5 py-2.5 text-xs md:text-[13px] font-medium">
      設計からデザイン、開発まで Web 制作と業務の仕組み化全般に対応します
    </div>

    <p class="mt-12 md:mt-16 text-center text-base md:text-xl font-bold leading-loose">
      <span class="marker-invert">大切な業務</span>を一から仕組みに。<br />
      運用コストを抑えられるよう<span class="marker">丁寧に設計</span>します。
    </p>

    <div class="mt-12 md:mt-16 grid md:grid-cols-3 gap-12 md:gap-8">
      {services.map((s) => (
        <div class="text-center">
          <svg class="w-24 h-24 mx-auto text-zinc-300 dark:text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d={s.icon} />
          </svg>
          <p class="mt-4 text-sm font-bold leading-relaxed text-zinc-500">
            {s.lines[0]}<br />{s.lines[1]}
          </p>
          <h3 class="mt-4 text-lg md:text-xl font-bold tracking-tight">{s.title}</h3>
          <p class="mt-4 text-sm leading-loose text-zinc-700 dark:text-zinc-300 text-left">
            {s.desc}
          </p>
          <div class="mt-5 flex items-center justify-between border-t border-zinc-300 dark:border-zinc-700 pt-4">
            <span class="text-[10px] tracking-[0.2em] uppercase text-zinc-500">Price</span>
            <span class="text-base font-bold tabular-nums">{s.price}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a
        href="#contact"
        class="inline-flex items-center justify-center bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 px-10 py-4 text-[13px] font-bold tracking-[0.18em] hover:bg-black dark:hover:bg-white transition-colors"
      >
        ご依頼・お問い合わせはこちら
      </a>
    </div>
  </div>
</section>
