---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<section id="contact" class="pt-8 md:pt-12">
  <!-- Full-width gray band (reference: yellow band) -->
  <div class="bg-zinc-200 dark:bg-zinc-800 py-14 md:py-20">
    <div class="max-w-[1000px] mx-auto px-6 md:px-10 flex flex-wrap items-center gap-8 md:gap-12">
      <div class="border-2 border-zinc-900 dark:border-zinc-100 px-6 md:px-10 py-4 md:py-5">
        <span class="text-xl md:text-3xl font-bold tracking-[0.14em] md:tracking-[0.22em]">CONTACT</span>
      </div>
      <div class="text-sm leading-loose">
        <p>お気軽にお問い合わせください。</p>
        <p>新規のご依頼も、既存業務の AI 化のご相談も歓迎です。</p>
      </div>
      <div class="ml-auto hidden md:block">
        <span class="text-[13px] font-bold tracking-[0.15em] pb-1.5 border-b-2 border-zinc-900 dark:border-zinc-100">お問い合わせ方法</span>
      </div>
    </div>
  </div>

  <!-- Form -->
  <div class="max-w-[1000px] mx-auto px-6 md:px-10 py-16 md:py-24">
    <form id="contact-form" class="max-w-2xl mx-auto space-y-8">
      <div class="grid md:grid-cols-2 gap-x-6 gap-y-8">
        <div>
          <label for="name" class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-700 dark:text-zinc-300 mb-2">お名前 <span class="text-zinc-900 dark:text-zinc-100">*</span></label>
          <input
            id="name"
            name="name"
            type="text"
            required
            placeholder="山田 太郎"
            class="w-full bg-transparent border-0 border-b border-zinc-300 dark:border-zinc-700 py-2 focus:border-zinc-900 dark:focus:border-zinc-100 focus:ring-0 outline-none transition placeholder:text-zinc-400"
          />
        </div>
        <div>
          <label for="email" class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-700 dark:text-zinc-300 mb-2">メールアドレス <span class="text-zinc-900 dark:text-zinc-100">*</span></label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="you@example.com"
            class="w-full bg-transparent border-0 border-b border-zinc-300 dark:border-zinc-700 py-2 focus:border-zinc-900 dark:focus:border-zinc-100 focus:ring-0 outline-none transition placeholder:text-zinc-400"
          />
        </div>
      </div>

      <div>
        <label for="company" class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-700 dark:text-zinc-300 mb-2">会社名 / 屋号</label>
        <input
          id="company"
          name="company"
          type="text"
          placeholder="株式会社サンプル"
          class="w-full bg-transparent border-0 border-b border-zinc-300 dark:border-zinc-700 py-2 focus:border-zinc-900 dark:focus:border-zinc-100 focus:ring-0 outline-none transition placeholder:text-zinc-400"
        />
      </div>

      <div>
        <label for="subject" class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-700 dark:text-zinc-300 mb-2">ご相談内容 <span class="text-zinc-900 dark:text-zinc-100">*</span></label>
        <select
          id="subject"
          name="subject"
          required
          class="w-full bg-transparent border-0 border-b border-zinc-300 dark:border-zinc-700 py-2 focus:border-zinc-900 dark:focus:border-zinc-100 focus:ring-0 outline-none transition"
        >
          <option value="">選択してください</option>
          <option value="web">Web サイト制作のご依頼</option>
          <option value="system">業務システム開発のご依頼</option>
          <option value="consulting">AI 導入・技術支援のご相談</option>
          <option value="other">その他のお問い合わせ</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-zinc-700 dark:text-zinc-300 mb-2">メッセージ <span class="text-zinc-900 dark:text-zinc-100">*</span></label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          placeholder="ご相談内容、ご予算、希望納期などをご記入ください。"
          class="w-full bg-transparent border-0 border-b border-zinc-300 dark:border-zinc-700 py-2 focus:border-zinc-900 dark:focus:border-zinc-100 focus:ring-0 outline-none transition resize-y placeholder:text-zinc-400"
        ></textarea>
      </div>

      <!-- honeypot -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
      )}

      <div class="flex items-center justify-between gap-4 flex-wrap pt-4">
        <p class="text-[11px] tracking-[0.16em] uppercase text-zinc-500">送信いただいた情報は、<a href="/privacy" target="_blank" rel="noopener" class="underline hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">プライバシーポリシー</a>に基づき、ご返信目的以外には使用しません。</p>
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center gap-3 px-8 py-3.5 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-sm font-bold tracking-[0.15em] hover:bg-black dark:hover:bg-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span class="btn-label">送信する</span>
          <svg class="btn-icon w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          <svg class="btn-spinner hidden w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" stroke-opacity="0.25" />
            <path d="M21 12a9 9 0 00-9-9" />
          </svg>
        </button>
      </div>

      <div id="form-status" class="hidden text-sm p-4 border"></div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status") as HTMLDivElement | null;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function showStatus(kind: "success" | "error", msg: string) {
    if (!status) return;
    status.className =
      "text-sm p-4 border " +
      (kind === "success"
        ? "bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 border-zinc-300 dark:border-zinc-700"
        : "bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 border-zinc-900 dark:border-zinc-100");
    status.textContent = msg;
  }

  function setLoading(loading: boolean) {
    if (!btn) return;
    btn.disabled = loading;
    const label = btn.querySelector(".btn-label") as HTMLElement | null;
    const icon = btn.querySelector(".btn-icon") as HTMLElement | null;
    const spinner = btn.querySelector(".btn-spinner") as HTMLElement | null;
    if (label) label.textContent = loading ? "送信中..." : "送信する";
    icon?.classList.toggle("hidden", loading);
    spinner?.classList.toggle("hidden", !loading);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status) return;

    setLoading(true);
    status.classList.add("hidden");

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        throw new Error(j.error || "送信に失敗しました");
      }

      showStatus("success", "お問い合わせありがとうございます。1〜2 営業日以内にご返信いたします。");
      form.reset();
    } catch (err) {
      const message = err instanceof Error ? err.message : "送信に失敗しました";
      showStatus("error", `送信に失敗しました: ${message}。お手数ですが時間をおいて再度お試しください。`);
    } finally {
      setLoading(false);
      status.classList.remove("hidden");
    }
  });
</script>
